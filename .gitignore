# Created by venv; see https://docs.python.org/3/library/venv.html
*
# Model weights (downloaded at runtime from Hugging Face)
model/*.pt

# Virtual environment
venv/

# Environment variables / secrets
.env

# Python cache
__pycache__/
*.pyc

# Uploaded/result files (optional — depends if you want to keep test uploads out of git)
static/uploads/*
static/results/*
!static/uploads/.gitkeep
!static/results/.gitkeep